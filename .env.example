# Copy to .env for local docker compose, or enter these in Portainer > Stack > Environment variables.
MYSQL_ROOT_PASSWORD=change-this-db-password
# Must be at least 32 characters (HS256 signing key). Shared by auth-service and api-gateway.
JWT_SECRET=change-this-to-a-long-random-string-of-32plus-chars
ADMIN_EMAIL=admin@orderly.com
ADMIN_PASSWORD=Admin@123
# Host port for the web app (only used to test before the Cloudflare tunnel is set up)
CLIENT_PORT=8088
